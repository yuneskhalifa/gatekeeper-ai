# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real API keys.

ANTHROPIC_API_KEY=

# SMTP — used by /api/send-email to actually send the compiled pitch email.
# Leave blank to disable sending (the Send button reports "not configured").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: force TLS. Defaults to true when SMTP_PORT is 465.
SMTP_SECURE=
